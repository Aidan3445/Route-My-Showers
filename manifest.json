{
  "manifest_version": 3,
  "name": "Route My Showers",
  "version": "0.1.0",
  "description": "Overlay GPX / RideWithGPS routes (with mile markers) on the Warmshowers host map.",
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": ["https://ridewithgps.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://warmshowers.org/*",
        "https://*.warmshowers.org/*",
        "https://warmshowers.com/*",
        "https://*.warmshowers.com/*"
      ],
      "js": ["page.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://warmshowers.org/*",
        "https://*.warmshowers.org/*",
        "https://warmshowers.com/*",
        "https://*.warmshowers.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
