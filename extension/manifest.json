{
  "manifest_version": 3,
  "name": "Route My Showers",
  "version": "0.6.0",
  "description": "Overlay RideWithGPS, Komoot, Strava and GPX routes (with mile markers) on the Warmshowers host map.",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://ridewithgps.com/*",
    "https://www.komoot.com/*",
    "https://www.komoot.de/*",
    "https://api.komoot.de/*",
    "https://www.strava.com/*",
    "https://strava.app.link/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Route My Showers",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png",
    "512": "icons/icon512.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://warmshowers.org/*",
        "https://*.warmshowers.org/*",
        "https://warmshowers.com/*",
        "https://*.warmshowers.com/*"
      ],
      "js": [
        "loader.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://warmshowers.org/*",
        "https://*.warmshowers.org/*",
        "https://warmshowers.com/*",
        "https://*.warmshowers.com/*"
      ],
      "js": [
        "gpx.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://ridewithgps.com/*",
        "https://www.komoot.com/*",
        "https://www.komoot.de/*",
        "https://www.strava.com/*"
      ],
      "js": [
        "gpx.js",
        "source.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page.js"
      ],
      "matches": [
        "https://warmshowers.org/*",
        "https://*.warmshowers.org/*",
        "https://warmshowers.com/*",
        "https://*.warmshowers.com/*"
      ]
    }
  ]
}
